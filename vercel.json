{
  "version": 2,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/index", "destination": "/", "statusCode": 301 },
    { "source": "/pages/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/pages/index", "destination": "/", "statusCode": 301 },
    { "source": "/explore", "destination": "/places", "statusCode": 301 },
    { "source": "/pages/:page.html", "destination": "/:page", "statusCode": 301 },
    { "source": "/pages/:page", "destination": "/:page", "statusCode": 301 },
    { "source": "/:page.html", "destination": "/:page", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://calzada-web.firebaseapp.com/__/auth/:path*" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/fares", "destination": "/pages/fares.html" },
    { "source": "/planner", "destination": "/pages/planner.html" },
    { "source": "/faq", "destination": "/pages/faq.html" },
    { "source": "/feedback", "destination": "/pages/feedback.html" },
    { "source": "/places", "destination": "/pages/places.html" },
    { "source": "/discover", "destination": "/pages/discover.html" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/business", "destination": "/pages/business.html" },
    { "source": "/my-business", "destination": "/pages/my-business.html" },
    { "source": "/submit", "destination": "/pages/submit.html" },
    { "source": "/admin", "destination": "/pages/admin.html" },
    { "source": "/calibrate-360", "destination": "/pages/calibrate-360.html" },
    { "source": "/plans", "destination": "/pages/plans.html" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Access-Control-Allow-Origin", "value": "https://calzadaph.com" }
      ]
    },
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://unpkg.com https://apis.google.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://res.cloudinary.com https://lh3.googleusercontent.com https://www.google.com https://*.basemaps.cartocdn.com https://tiles.openfreemap.org https://graph.facebook.com https://*.fbsbx.com https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://unpkg.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://tiles.openfreemap.org https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://calzada-web.firebaseapp.com https://cdn.jsdelivr.net https://www.googleapis.com https://router.project-osrm.org https://routing.openstreetmap.de https://geocode.arcgis.com https://nominatim.openstreetmap.org https://res.cloudinary.com; frame-src 'self' https://calzada-web.firebaseapp.com https://accounts.google.com https://www.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; media-src 'self' https://res.cloudinary.com" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/assets/360/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(about|fares|planner|faq|feedback|places|discover|login|business|my-business|submit|admin|calibrate-360|plans)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminders/dispatch",
      "schedule": "0 0 * * *"
    }
  ]
}
