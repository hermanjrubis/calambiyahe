PORT=5000
GROQ_API_KEY=gsk_placeholder_key
CARTO_API_KEY=your_carto_api_key
NODE_ENV=development



# Gmail SMTP Configuration (Nodemailer)
# Requires 2-Step Verification enabled, then generate an App Password from Google Account settings
GMAIL_USER=thecalzada@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Firebase Admin SDK Service Account (Required for Vercel deployment)
# Paste the full contents of your serviceAccountKey.json as a single-line minified JSON string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Cloudinary (required - all user-uploaded images are hosted here)
# Uploads are SIGNED and happen server-side, so the secret never reaches the browser
# and there is no unsigned upload preset. Find all three under Cloudinary dashboard ->
# Settings -> API Keys. Paste the secret's raw value only: copying it with the
# surrounding brackets yields a confusing "api_secret mismatch" at runtime.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_15_digit_api_key
CLOUDINARY_API_SECRET=your_27_character_api_secret
