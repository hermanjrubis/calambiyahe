rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidCloudinaryUrl(url) {
      return url is string && url.matches('^https://res\\.cloudinary\\.com/.*');
    }

    function isValidLocation(loc) {
      return loc is map
        && loc.keys().hasOnly(['lat', 'lng'])
        && 'lat' in loc && 'lng' in loc
        && loc.lat is number && loc.lng is number
        && loc.lat >= 14.10 && loc.lat <= 14.30
        && loc.lng >= 121.05 && loc.lng <= 121.25;
    }

    function isValidSocialLinks(links) {
      return links == null || (
        links is map
        && links.keys().hasOnly(['facebook', 'instagram', 'tiktok'])
        && (links.get('facebook', null) == null || (links.facebook is string && links.facebook.size() <= 200 && links.facebook.matches('^https://www\\.facebook\\.com/([A-Za-z0-9.]{1,100}|profile\\.php\\?id=[0-9]{5,20})$')))
        && (links.get('instagram', null) == null || (links.instagram is string && links.instagram.size() <= 200 && links.instagram.matches('^https://www\\.instagram\\.com/[A-Za-z0-9._]{1,30}$')))
        && (links.get('tiktok', null) == null || (links.tiktok is string && links.tiktok.size() <= 200 && links.tiktok.matches('^https://www\\.tiktok\\.com/@[A-Za-z0-9._]{1,24}$')))
      );
    }

    // User profiles & activity data.
    // Same access as the former /users/{userId}/{document=**} wildcard, except that it no
    // longer covers trips: rules are OR-ed, so a broad match there would override the
    // stricter trips rules below.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{collectionId}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && collectionId != 'trips' && collectionId != 'reminders' && collectionId != 'routeHistory';
    }

    // Trip history: users/{uid}/trips/{tripId} (tripId = the journey id).
    // Owner only, create-only (no edits), signed-in non-anonymous accounts only.
    // The origin is stored as a label, never as coordinates.
    function isValidTripLeg(leg) {
      // Kept lean: rules stop at 1000 evaluated expressions per request and this runs once
      // per leg (up to 10). Reading a missing key fails, so all four keys are required.
      return leg.keys().hasOnly(['type', 'minutes', 'km', 'fare'])
        && leg.type in ['walk', 'jeepney']
        && leg.minutes is number && leg.km is number && leg.fare is number;
    }

    function hasValidTripLegs(legs) {
      return legs is list && legs.size() <= 10
        && (legs.size() < 1 || isValidTripLeg(legs[0]))
        && (legs.size() < 2 || isValidTripLeg(legs[1]))
        && (legs.size() < 3 || isValidTripLeg(legs[2]))
        && (legs.size() < 4 || isValidTripLeg(legs[3]))
        && (legs.size() < 5 || isValidTripLeg(legs[4]))
        && (legs.size() < 6 || isValidTripLeg(legs[5]))
        && (legs.size() < 7 || isValidTripLeg(legs[6]))
        && (legs.size() < 8 || isValidTripLeg(legs[7]))
        && (legs.size() < 9 || isValidTripLeg(legs[8]))
        && (legs.size() < 10 || isValidTripLeg(legs[9]));
    }

    function isValidTrip(trip) {
      return trip.keys().hasOnly([
          'destName', 'destLat', 'destLng', 'destCategory', 'originLabel', 'mode', 'legs',
          'startedAt', 'arrivedAt', 'actualMinutes', 'estimatedMinutes', 'distanceKm', 'fare', 'createdAt'
        ])
        && trip.keys().size() == 14
        && trip.destName is string && trip.destName.size() >= 1 && trip.destName.size() <= 120
        && trip.destLat is number && trip.destLng is number
        && (trip.destCategory == null || (trip.destCategory is string && trip.destCategory.size() <= 40))
        && trip.originLabel is string && trip.originLabel.size() <= 120
        // no coordinates hidden in the label (a number with 3+ decimals)
        && !trip.originLabel.matches('.*[0-9]+[.][0-9]{3,}.*')
        && trip.mode in ['walk', 'jeepney']
        && hasValidTripLegs(trip.legs)
        && (trip.startedAt == null || trip.startedAt is timestamp)
        && trip.arrivedAt is timestamp
        && (trip.actualMinutes == null || trip.actualMinutes is number)
        && trip.estimatedMinutes is number
        && trip.distanceKm is number
        && trip.fare is number
        && trip.createdAt == request.time;
    }

    match /users/{userId}/trips/{tripId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isValidTrip(request.resource.data);
      allow update: if false;
    }

    // Smart Travel Reminders: users/{uid}/reminders/{reminderId}
    // Owner read & delete; owner create (non-anonymous, exact 13 fields, bounds & 30-day limits);
    // owner update ONLY to set status from "scheduled" to "cancelled".
    function isValidReminder(r) {
      return r.keys().hasOnly([
          'destName', 'destLat', 'destLng', 'originLabel', 'mode',
          'leaveAt', 'arriveBy', 'remindAt', 'channel', 'lang',
          'status', 'createdAt', 'sentAt',
          'fareRegular', 'fareDiscounted'
        ])
        && (r.keys().size() == 13 || r.keys().size() == 15)
        && r.destName is string && r.destName.size() >= 1 && r.destName.size() <= 120
        && r.destLat is number && r.destLng is number
        && r.destLat >= 13.9 && r.destLat <= 14.6
        && r.destLng >= 120.9 && r.destLng <= 121.7
        && r.originLabel is string && r.originLabel.size() <= 120
        // no coordinates hidden in the label (a number with 3+ decimals)
        && !r.originLabel.matches('.*[0-9]+[.][0-9]{3,}.*')
        && r.mode in ['walk', 'jeepney']
        && r.leaveAt is timestamp
        && r.leaveAt >= request.time
        && r.leaveAt < request.time + duration.value(30, 'd')
        && (r.arriveBy == null || r.arriveBy is timestamp)
        && r.remindAt is timestamp
        && r.remindAt > request.time
        && r.remindAt < request.time + duration.value(30, 'd')
        && r.channel == 'email'
        && r.lang in ['en', 'tl']
        && r.status == 'scheduled'
        && r.createdAt == request.time
        && r.sentAt == null
        && (!('fareRegular' in r) || (r.fareRegular is number && r.fareRegular >= 0))
        && (!('fareDiscounted' in r) || (r.fareDiscounted is number && r.fareDiscounted >= 0));
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isValidReminder(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'scheduled'
        && request.resource.data.status == 'cancelled';
    }

    // Route History: users/{uid}/routeHistory/{id}
    // Owner read & delete; owner create (planned, exact 16 keys, coordinates & bounds limits);
    // Owner update only for specific transitions.
    function isValidRouteHistoryCreate(r) {
      return r.keys().hasOnly([
          'status', 'destName', 'destLat', 'destLng', 'destCategory',
          'originLabel', 'originKind', 'originBarangay', 'mode',
          'estimatedMinutes', 'distanceKm', 'fare',
          'plannedAt', 'startedAt', 'endedAt', 'cancelReason'
        ])
        && r.keys().size() == 16
        && r.status == 'planned'
        && r.destName is string && r.destName.size() >= 1 && r.destName.size() <= 120
        && r.destLat is number && r.destLng is number
        && r.destLat >= 13.9 && r.destLat <= 14.6
        && r.destLng >= 120.9 && r.destLng <= 121.7
        && (r.destCategory == null || (r.destCategory is string && r.destCategory.size() <= 40))
        && r.originLabel is string && r.originLabel.size() <= 120
        // no coordinates hidden in the label (a number with 3+ decimals)
        && !r.originLabel.matches('.*[0-9]+[.][0-9]{3,}.*')
        && r.originKind in ['place', 'my_location', 'pinned']
        && (r.originBarangay == null || (r.originBarangay is string && r.originBarangay.size() <= 40))
        && r.mode in ['walk', 'jeepney']
        && r.estimatedMinutes is number && r.estimatedMinutes >= 0
        && r.distanceKm is number && r.distanceKm >= 0
        && r.fare is number && r.fare >= 0
        && r.plannedAt == request.time
        && r.startedAt == null
        && r.endedAt == null
        && r.cancelReason == null;
    }

    match /users/{userId}/routeHistory/{routeId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isValidRouteHistoryCreate(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && (
          // Transition 1: planned -> started (sets startedAt == request.time)
          (
            resource.data.status == 'planned'
            && request.resource.data.status == 'started'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
            && request.resource.data.startedAt == request.time
          )
          // Transition 2: planned -> cancelled (sets cancelReason, optional endedAt)
          || (
            resource.data.status == 'planned'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason'])
            && request.resource.data.cancelReason in ['user_cancelled', 'switched_route']
          )
          || (
            resource.data.status == 'planned'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'endedAt'])
            && request.resource.data.cancelReason in ['user_cancelled', 'switched_route']
            && (request.resource.data.endedAt == null || request.resource.data.endedAt == request.time)
          )
          // Transition 3: started -> cancelled (sets cancelReason, optional endedAt)
          || (
            resource.data.status == 'started'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'endedAt'])
            && request.resource.data.cancelReason in ['user_cancelled', 'switched_route']
            && (request.resource.data.endedAt == null || request.resource.data.endedAt == request.time)
          )
          || (
            resource.data.status == 'started'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason'])
            && request.resource.data.cancelReason in ['user_cancelled', 'switched_route']
          )
          // Transition 4: started -> arrived (sets endedAt == request.time)
          || (
            resource.data.status == 'started'
            && request.resource.data.status == 'arrived'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
            && request.resource.data.endedAt == request.time
          )
        );
    }

    // Submissions collection security rules (Legacy / Preserved)
    match /submissions/{submissionId} {
      // FIX 5: Disable new creations, keep read/update/delete as they are
      allow create: if false;
      allow read: if request.auth != null
        && (resource.data.submittedBy == request.auth.uid || resource.data.status == 'approved' || request.auth.token.admin == true);
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null
        && resource.data.submittedBy == request.auth.uid && resource.data.status == 'pending';
    }

    function isValidOfferingItem(item) {
      return item is string && item.size() >= 1 && item.size() <= 40;
    }

    function hasValidOfferings(list) {
      return list is list && list.size() >= 1 && list.size() <= 10
        && (list.size() < 1 || isValidOfferingItem(list[0]))
        && (list.size() < 2 || isValidOfferingItem(list[1]))
        && (list.size() < 3 || isValidOfferingItem(list[2]))
        && (list.size() < 4 || isValidOfferingItem(list[3]))
        && (list.size() < 5 || isValidOfferingItem(list[4]))
        && (list.size() < 6 || isValidOfferingItem(list[5]))
        && (list.size() < 7 || isValidOfferingItem(list[6]))
        && (list.size() < 8 || isValidOfferingItem(list[7]))
        && (list.size() < 9 || isValidOfferingItem(list[8]))
        && (list.size() < 10 || isValidOfferingItem(list[9]));
    }

    function isValidOpenHours(h) {
      return h is map
        && h.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && (!('mon' in h) || (h.mon is list && h.mon.size() <= 2))
        && (!('tue' in h) || (h.tue is list && h.tue.size() <= 2))
        && (!('wed' in h) || (h.wed is list && h.wed.size() <= 2))
        && (!('thu' in h) || (h.thu is list && h.thu.size() <= 2))
        && (!('fri' in h) || (h.fri is list && h.fri.size() <= 2))
        && (!('sat' in h) || (h.sat is list && h.sat.size() <= 2))
        && (!('sun' in h) || (h.sun is list && h.sun.size() <= 2));
    }

    function isValidTour360Photo(p) {
      return p is map && p.keys().hasOnly(['url', 'thumbUrl', 'label'])
        && p.url is string && p.thumbUrl is string
        && p.label is string && p.label.size() <= 60;
    }

    function isValidTour360(t) {
      return t is map
        && t.keys().hasOnly(['photos', 'publishedAt', 'version'])
        && t.photos is list && t.photos.size() >= 1 && t.photos.size() <= 5
        && (t.photos.size() < 1 || isValidTour360Photo(t.photos[0]))
        && (t.photos.size() < 2 || isValidTour360Photo(t.photos[1]))
        && (t.photos.size() < 3 || isValidTour360Photo(t.photos[2]))
        && (t.photos.size() < 4 || isValidTour360Photo(t.photos[3]))
        && (t.photos.size() < 5 || isValidTour360Photo(t.photos[4]))
        && t.publishedAt is timestamp
        && t.version is number;
    }

    // Keep prices in sync with window.CALZADA_PLANS in public/js/plans-config.js
    function planPrice(p) {
      return p == 'listed' ? 59 : (p == 'plus360' ? 199 : (p == 'featured' ? 299 : 0));
    }

    // Businesses collection security rules (Instagram Business model)
    match /businesses/{businessId} {
      // Create: Authenticated owner only, status forced to pending, profilePhotoUrl & approvedAt forced to null
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('profilePhotoUrl', null) == null
        && request.resource.data.get('approvedAt', null) == null
        // FIX 2: submittedAt must equal request.time
        && request.resource.data.submittedAt == request.time
        // FIX 3: Field allowlist and size constraints
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'address', 'description', 'contactNumber', 
          'ownerId', 'status', 'submittedAt', 'profilePhotoUrl', 'approvedAt',
          'serviceType', 'socialLinks', 'location', 'plan',
          'thumbnailUrl', 'offerings', 'openHours', 'barangay', 'landmark'
        ])
        && request.resource.data.plan in ['listed', 'plus360', 'featured']
        && !('reviewNote' in request.resource.data)
        && !('paidAt' in request.resource.data)
        && !('featuredUntil' in request.resource.data)
        && !('amountDue' in request.resource.data)
        && !('tour360' in request.resource.data)
        && !('shoot360' in request.resource.data)
        && !('shoot360Date' in request.resource.data)
        && request.resource.data.name is string 
        && request.resource.data.name.size() >= 1 
        && request.resource.data.name.size() <= 80
        && request.resource.data.address is string 
        && request.resource.data.address.size() >= 1 
        && request.resource.data.address.size() <= 160
        && (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
        && request.resource.data.category in ['malls', 'eateries', 'coffee', 'schools', 'terminals', 'establishments']
        && (request.resource.data.contactNumber == null || (request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() <= 20))
        && (request.resource.data.get('serviceType', null) == null || (request.resource.data.serviceType is string && request.resource.data.serviceType.size() >= 2 && request.resource.data.serviceType.size() <= 40))
        && isValidSocialLinks(request.resource.data.get('socialLinks', null))
        && isValidLocation(request.resource.data.location)
        && isValidCloudinaryUrl(request.resource.data.thumbnailUrl)
        && hasValidOfferings(request.resource.data.offerings)
        && isValidOpenHours(request.resource.data.openHours)
        && request.resource.data.barangay in ['Uno', 'Real', 'Halang']
        && (request.resource.data.get('landmark', null) == null || (request.resource.data.landmark is string && request.resource.data.landmark.size() <= 80));

      // Read: Public read if approved; Owner can read own doc regardless of status; Admins can read all
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && (resource.data.ownerId == request.auth.uid || request.auth.token.admin == true));

      // Update:
      // 1. Admin: explicit moderation/content field allowlist
      // 2. Owner: edit profile when approved
      // 3. Owner: resubmit from needs_changes
      // 4. Owner: change plan while pending
      // 5. Owner: change plan while awaiting_payment
      // 6. Owner: pay (awaiting_payment -> payment_review)
      allow update: if request.auth != null && resource != null && (
        (
          request.auth.token.admin == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'approvedAt', 'rejectionReason', 'reviewNote', 'name', 
            'category', 'address', 'description', 'contactNumber', 'profilePhotoUrl', 'updatedAt',
            'serviceType', 'socialLinks', 'location',
            'plan', 'amountDue', 'detailsApprovedAt', 'paidAt', 'featuredUntil', 'shoot360', 'legacyPlan', 'lastPaymentId',
            'thumbnailUrl', 'offerings', 'openHours', 'barangay', 'landmark', 'tour360', 'shoot360Date'
          ])
          // FIX 2: require updatedAt == request.time when changed, forbid changing submittedAt
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('submittedAt' in resource.data) || request.resource.data.submittedAt == resource.data.submittedAt)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['serviceType']) || request.resource.data.get('serviceType', null) == null || (request.resource.data.serviceType is string && request.resource.data.serviceType.size() >= 2 && request.resource.data.serviceType.size() <= 40))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['socialLinks']) || isValidSocialLinks(request.resource.data.get('socialLinks', null)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['location']) || isValidLocation(request.resource.data.location))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewNote']) || request.resource.data.get('reviewNote', null) == null || (request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 500))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shoot360']) || request.resource.data.get('shoot360', null) == null || request.resource.data.shoot360 in ['none', 'to_schedule', 'scheduled', 'done'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['shoot360Date']) || request.resource.data.get('shoot360Date', null) == null || request.resource.data.shoot360Date is timestamp || (request.resource.data.shoot360Date is string && request.resource.data.shoot360Date.size() <= 40))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tour360']) || request.resource.data.get('tour360', null) == null || (request.resource.data.tour360 is map && isValidTour360(request.resource.data.tour360)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['thumbnailUrl']) || isValidCloudinaryUrl(request.resource.data.thumbnailUrl))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['offerings']) || hasValidOfferings(request.resource.data.offerings))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['openHours']) || isValidOpenHours(request.resource.data.openHours))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['barangay']) || request.resource.data.barangay in ['Uno', 'Real', 'Halang'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['landmark']) || request.resource.data.landmark == null || (request.resource.data.landmark is string && request.resource.data.landmark.size() <= 80))
        ) || (
          // Owner edit profile (only when approved)
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'profilePhotoUrl', 'description', 'updatedAt', 'socialLinks',
            'thumbnailUrl', 'offerings', 'openHours'
          ])
          // FIX 3: Owner update description null or string <= 500
          && (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
          // FIX 4: profilePhotoUrl (when not null) must match cloudinary URL regex
          && (request.resource.data.profilePhotoUrl == null || isValidCloudinaryUrl(request.resource.data.profilePhotoUrl))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['thumbnailUrl']) || isValidCloudinaryUrl(request.resource.data.thumbnailUrl))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['offerings']) || hasValidOfferings(request.resource.data.offerings))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['openHours']) || isValidOpenHours(request.resource.data.openHours))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['socialLinks']) || isValidSocialLinks(request.resource.data.get('socialLinks', null)))
          // FIX 2: require updatedAt == request.time when changed, forbid changing submittedAt
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('submittedAt' in resource.data) || request.resource.data.submittedAt == resource.data.submittedAt)
        ) || (
          // Owner resubmit from needs_changes
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'needs_changes'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'name', 'category', 'serviceType', 'address', 'location', 
            'description', 'contactNumber', 'socialLinks', 'plan', 'updatedAt',
            'thumbnailUrl', 'offerings', 'openHours', 'barangay', 'landmark'
          ])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
          && request.resource.data.address is string && request.resource.data.address.size() >= 1 && request.resource.data.address.size() <= 160
          && (request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
          && request.resource.data.category in ['malls', 'eateries', 'coffee', 'schools', 'terminals', 'establishments']
          && (request.resource.data.contactNumber == null || (request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() <= 20))
          && (request.resource.data.get('serviceType', null) == null || (request.resource.data.serviceType is string && request.resource.data.serviceType.size() >= 2 && request.resource.data.serviceType.size() <= 40))
          && isValidSocialLinks(request.resource.data.get('socialLinks', null))
          && isValidLocation(request.resource.data.location)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['thumbnailUrl']) || isValidCloudinaryUrl(request.resource.data.thumbnailUrl))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['offerings']) || hasValidOfferings(request.resource.data.offerings))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['openHours']) || isValidOpenHours(request.resource.data.openHours))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['barangay']) || request.resource.data.barangay in ['Uno', 'Real', 'Halang'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['landmark']) || request.resource.data.landmark == null || (request.resource.data.landmark is string && request.resource.data.landmark.size() <= 80))
          && request.resource.data.plan in ['listed', 'plus360', 'featured']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('submittedAt' in resource.data) || request.resource.data.submittedAt == resource.data.submittedAt)
        ) || (
          // Owner change plan: while pending
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'updatedAt'])
          && request.resource.data.plan in ['listed', 'plus360', 'featured']
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('submittedAt' in resource.data) || request.resource.data.submittedAt == resource.data.submittedAt)
        ) || (
          // Owner change plan: while awaiting_payment
          resource.data.ownerId == request.auth.uid
          && resource.data.status == 'awaiting_payment'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'amountDue', 'updatedAt'])
          && request.resource.data.plan in ['listed', 'plus360', 'featured']
          && request.resource.data.amountDue == planPrice(request.resource.data.plan)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('submittedAt' in resource.data) || request.resource.data.submittedAt == resource.data.submittedAt)
        ) || (
          // Owner pay: awaiting_payment or payment_review -> payment_review (initial pay or receipt replacement)
          resource.data.ownerId == request.auth.uid
          && (resource.data.status == 'awaiting_payment' || resource.data.status == 'payment_review')
          && request.resource.data.status == 'payment_review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastPaymentId', 'updatedAt'])
          && request.resource.data.lastPaymentId is string
          && existsAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId))
          && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.businessId == businessId
          && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.lastPaymentId)).data.status == 'submitted'
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('submittedAt' in resource.data) || request.resource.data.submittedAt == resource.data.submittedAt)
        )
      );

      // Delete: Admins only
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Wizard drafts: businessDrafts/{userId}
    // Readable and writable by that user only, max ~50 KB.
    match /businessDrafts/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().size() <= 25;
    }

    match /businesses/{businessId}/private/{docId} {
      allow create: if request.auth != null && docId == 'owner'
        && getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerEmail'])
        && (request.resource.data.ownerEmail == null
            || request.resource.data.ownerEmail == request.auth.token.email);
      allow read: if request.auth != null && (request.auth.token.admin == true
        || get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Payments collection security rules (Phase 1.3)
    match /payments/{paymentId} {
      // Create: owner only. ownerId == auth.uid. status == 'submitted'. The business belongs to the owner and is awaiting_payment or payment_review (for receipt replacement). amountDue == business.amountDue.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasOnly([
          'businessId', 'ownerId', 'plan', 'amountDue', 'referenceNo',
          'receiptUrl', 'status', 'reviewNote', 'submittedAt', 'reviewedAt', 'reviewedBy'
        ])
        && request.resource.data.businessId is string
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && (get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.status in ['awaiting_payment', 'payment_review'])
        && request.resource.data.amountDue == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.amountDue
        && request.resource.data.plan == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.plan
        && request.resource.data.referenceNo is string
        && request.resource.data.referenceNo.matches('^[0-9]{10,20}$')
        // The reference-number lock must be written in the same batch and point at this payment,
        // so a reference number can never be used twice even if someone skips the website.
        && existsAfter(/databases/$(database)/documents/paymentRefs/$(request.resource.data.referenceNo))
        && getAfter(/databases/$(database)/documents/paymentRefs/$(request.resource.data.referenceNo)).data.paymentId == paymentId
        && isValidCloudinaryUrl(request.resource.data.receiptUrl)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewNote == null;

      // Read: the owner or an admin.
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || request.auth.token.admin == true);

      // Update: admin only (status, reviewNote, reviewedAt == request.time, reviewedBy == auth.uid).
      allow update: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['verified', 'not_matched']
        && (request.resource.data.get('reviewNote', null) == null || (request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 500))
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;

      // Delete: never.
      allow delete: if false;
    }

    // Payment reference number lock (Phase 1.4)
    match /paymentRefs/{referenceNo} {
      // Create: owner only, and only together with the matching payment (existsAfter the payment).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['businessId', 'paymentId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && referenceNo.matches('^[0-9]{10,20}$')
        && request.resource.data.paymentId is string
        && existsAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId))
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.referenceNo == referenceNo
        && getAfter(/databases/$(database)/documents/payments/$(request.resource.data.paymentId)).data.businessId == request.resource.data.businessId;

      // Read: admin only.
      allow read: if request.auth != null && request.auth.token.admin == true;

      // Update: never. Delete: admin only, used when a payment is marked "doesn't match"
      // so the owner can send the same reference number again with a clearer receipt.
      allow update: if false;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Posts collection security rules (Phase 4.5 & Phase 1.5)
    match /posts/{postId} {
      // Create: Authenticated user who owns the post, status forced to 'active',
      // likeCount forced to 0, photoUrls list with 1 to 5 items,
      // with a cross-lookup verifying that the referenced business exists,
      // belongs to the requester, and is admin-approved.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.likeCount == 0
        && request.resource.data.businessId is string
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() >= 1
        && request.resource.data.photoUrls.size() <= 5
        // FIX 4: Every photoUrl item must match Cloudinary URL regex with size guards
        && isValidCloudinaryUrl(request.resource.data.photoUrls[0])
        && (request.resource.data.photoUrls.size() < 2 || isValidCloudinaryUrl(request.resource.data.photoUrls[1]))
        && (request.resource.data.photoUrls.size() < 3 || isValidCloudinaryUrl(request.resource.data.photoUrls[2]))
        && (request.resource.data.photoUrls.size() < 4 || isValidCloudinaryUrl(request.resource.data.photoUrls[3]))
        && (request.resource.data.photoUrls.size() < 5 || isValidCloudinaryUrl(request.resource.data.photoUrls[4]))
        // FIX 3: keys().hasOnly([...]) and caption null or string <= 500
        && request.resource.data.keys().hasOnly([
          'businessId', 'businessName', 'businessCategory', 'ownerId', 
          'photoUrls', 'caption', 'likeCount', 'createdAt', 'updatedAt', 'status',
          'label', 'promoUntil'
        ])
        && (request.resource.data.caption == null || (request.resource.data.caption is string && request.resource.data.caption.size() <= 500))
        && (!('label' in request.resource.data) || request.resource.data.label in ['announcement', 'promo', 'new_item'])
        && (!('promoUntil' in request.resource.data) || request.resource.data.promoUntil == null || request.resource.data.promoUntil is timestamp)
        // FIX 2: createdAt == request.time, updatedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == null
        // Cross-lookup to referenced business
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.status == 'approved'
        && request.resource.data.businessName == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.name
        && request.resource.data.businessCategory == get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.category;

      // Read: Public (no gate) for non-hidden posts, owner or admin for hidden posts
      allow read: if resource.data.get('status', 'active') != 'hidden'
        || (request.auth != null && (resource.data.ownerId == request.auth.uid || request.auth.token.admin == true));

      // Update:
      // Branch 1: Owner editing ONLY caption and updatedAt
      // Branch 2: Any authenticated user atomically toggling their own like (+1/-1 synchronized with like doc)
      // Branch 3: Admin moderation (status, pinnedUntil, updatedAt, etc.)
      allow update: if request.auth != null && (
        (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'updatedAt'])
          // FIX 3: caption null or string <= 500
          && (request.resource.data.caption == null || (request.resource.data.caption is string && request.resource.data.caption.size() <= 500))
          // FIX 2: require updatedAt == request.time when changed, forbid changing createdAt
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time)
          && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        ) || (
          // FIX 1: Require like document's state to actually change
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && (
            (
              request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            ) || (
              request.resource.data.likeCount == resource.data.likeCount - 1
              && request.resource.data.likeCount >= 0
              && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            )
          )
        ) || (
          request.auth.token.admin == true
        )
      );

      // Delete: The post's own owner OR admin
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || request.auth.token.admin == true);

      // Likes subcollection: Each user manages ONLY their own like document
      match /likes/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null
          && (request.auth.uid == uid || request.auth.token.admin == true);
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Place Reviews: admin may read and write (hide/restore). Non-admins denied direct client SDK access.
    // Reviews are written by the server (Admin SDK). The admin client may only hide or restore.
    match /place_reviews/{reviewId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hiddenReason', 'updatedAt'])
        && request.resource.data.status in ['active', 'hidden']
        && (request.resource.data.get('hiddenReason', null) == null
            || (request.resource.data.hiddenReason is string && request.resource.data.hiddenReason.size() <= 500));
      allow create, delete: if false;
    }

    // Admin Activity Feed: Admin-only read, server-only write.
    match /adminActivity/{activityId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Email Log: Admin-only read, server-only write.
    match /emailLog/{logId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}

